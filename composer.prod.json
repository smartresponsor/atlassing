{
  "name": "atlassing/atlas",
  "description": "Smart Responsor Atlas production component runtime.",
  "type": "symfony-bundle",
  "license": "proprietary",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/smartresponsor/cruding.git",
      "no-api": true
    },
    {
      "type": "vcs",
      "url": "https://github.com/smartresponsor/interfacing.git",
      "no-api": true
    },
    {
      "type": "vcs",
      "url": "https://github.com/smartresponsor/objecting.git",
      "no-api": true
    },
    {
      "type": "vcs",
      "url": "https://github.com/smartresponsor/viewing.git",
      "no-api": true
    }
  ],
  "require": {
    "cruding/crud": "dev-master",
    "doctrine/orm": "^3.4",
    "easycorp/easyadmin-bundle": "^5.0",
    "interfacing/interface": "dev-master",
    "objecting/object": "dev-master",
    "php": "^8.4",
    "symfony/config": "^8.1",
    "symfony/console": "^8.1",
    "symfony/dependency-injection": "^8.1",
    "symfony/framework-bundle": "^8.1",
    "symfony/http-kernel": "^8.1",
    "symfony/process": "^8.1",
    "symfony/yaml": "^8.1",
    "viewing/view": "dev-master"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "config": {
    "sort-packages": true
  },
  "extra": {
    "smart_responsor": {
      "component": "atlassing",
      "package": "atlassing/atlas",
      "business_prefix": "Atlas",
      "database_prefix": "atlas_",
      "surface_owner_root": "atlassing"
    }
  }
}
