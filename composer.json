{
  "name": "atlassing/atlas",
  "description": "Smart Responsor Atlas component for quality, maturity, readiness, and documentation coverage surfaces.",
  "type": "symfony-bundle",
  "license": "proprietary",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "repositories": [
    {
      "type": "path",
      "url": "../Collectioning",
      "options": { "symlink": true }
    },
    {
      "type": "path",
      "url": "../Tabling",
      "options": { "symlink": true }
    },
    {
      "type": "path",
      "url": "../Cruding",
      "options": { "symlink": true }
    },
    {
      "type": "path",
      "url": "../Gating",
      "options": { "symlink": true }
    },
    {
      "type": "path",
      "url": "../Interfacing",
      "options": { "symlink": true }
    },
    {
      "type": "path",
      "url": "../Objecting",
      "options": { "symlink": true }
    },
    {
      "type": "path",
      "url": "../Viewing",
      "options": { "symlink": true }
    }
  ],
  "require": {
    "collectioning/collection": "*@dev",
    "cruding/crud": "*@dev",
    "easycorp/easyadmin-bundle": "^5.0",
    "interfacing/interface": "*@dev",
    "objecting/object": "*@dev",
    "php": "^8.4",
    "symfony/config": "^8.1",
    "symfony/dependency-injection": "^8.1",
    "symfony/framework-bundle": "^8.1",
    "symfony/http-kernel": "^8.1",
    "symfony/console": "^8.1",
    "symfony/yaml": "^8.1",
    "tabling/table": "*@dev",
    "doctrine/orm": "^3.4",
    "symfony/process": "^8.1",
    "viewing/view": "*@dev"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95",
    "gating/gate": "*@dev",
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^12.0",
    "symfony/panther": "^2.4",
    "symfony/phpunit-bridge": "^8.1",
    "symfony/test-pack": "^1.2"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "cs:check": "php-cs-fixer fix --dry-run --diff --verbose",
    "coverage": [
      "@php -r \"if (!is_dir('var/coverage')) { mkdir('var/coverage', 0777, true); }\"",
      "@php -d xdebug.mode=coverage vendor/bin/phpunit --path-coverage --coverage-text=var/coverage/summary.txt"
    ],
    "test:functional": "phpunit --testsuite functional",
    "test:browser": "phpunit --testsuite browser",
    "cs:fix": "php-cs-fixer fix --verbose",
    "gating:check": "php vendor/bin/gating check --target=. --profile=config/atlas_gating_profile.yaml --rule-set=config/atlas_gating_rules.yaml --policy-root=vendor/gating/gate/.gating --severity-config=vendor/gating/gate/.gating/config/severity.yaml",
    "phpstan": "phpstan analyse --memory-limit=1G",
    "test": "phpunit",
    "quality": [
      "@cs:check",
      "@phpstan",
      "@test"
    ]
  },
  "config": {
    "sort-packages": true
  },
  "extra": {
    "smart_responsor": {
      "component": "atlassing",
      "package": "atlassing/atlas",
      "business_prefix": "Atlas",
      "database_prefix": "atlas_",
      "surface_owner_root": "atlassing"
    }
  }
}
