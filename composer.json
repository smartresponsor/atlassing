{
  "name": "atlassing/atlas",
  "description": "Smart Responsor Atlas component for quality, maturity, readiness, and documentation coverage surfaces.",
  "type": "symfony-bundle",
  "license": "proprietary",
  "require": {
    "php": "^8.4",
    "symfony/config": "^8.1",
    "symfony/dependency-injection": "^8.1",
    "symfony/http-kernel": "^8.1",
    "symfony/console": "^8.1",
    "symfony/yaml": "^8.1",
    "doctrine/orm": "^3.4",
    "symfony/process": "^8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0",
    "symfony/phpunit-bridge": "^8.1"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "extra": {
    "smart_responsor": {
      "component": "atlassing",
      "package": "atlassing/atlas",
      "business_prefix": "Atlas",
      "database_prefix": "atlas_",
      "surface_owner_root": "atlassing"
    }
  }
}
